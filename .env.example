# ── Required in production ────────────────────────────────────────────────
# Secret used to sign image URLs. Any long random string.
APP_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL with the pgvector extension available. When unset, the app uses
# an embedded Postgres (PGlite + pgvector) stored at PGLITE_DIR — great for
# local development and single-instance deployments with a persistent volume.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
PGLITE_DIR=./.data/pglite

# ── Image storage ─────────────────────────────────────────────────────────
# disk     → files under STORAGE_DIR (needs a persistent volume in production)
# database → blobs in Postgres (no volume needed; simplest with DATABASE_URL)
STORAGE_DRIVER=disk
STORAGE_DIR=./.data/uploads
IMAGE_MAX_BYTES=10485760
IMAGE_KEEP_ORIGINAL=false

# ── Semantic image matching ───────────────────────────────────────────────
SIMILARITY_PROVIDER=clip
SIMILARITY_MODEL=Xenova/clip-vit-base-patch32
SIMILARITY_DTYPE=q8
MODEL_CACHE_DIR=./.cache/models
# Cosine-similarity thresholds (calibrate with `npm run calibrate`)
SIMILARITY_HIGH_THRESHOLD=0.86
SIMILARITY_POSSIBLE_THRESHOLD=0.66

# ── Consensus thresholds (percent) ────────────────────────────────────────
CONSENSUS_HIGH=75
CONSENSUS_MODERATE=50
CONSENSUS_LOW=25

# ── Misc ──────────────────────────────────────────────────────────────────
PORT=3000
# Show the "Create demo session" launcher on the home page.
DEMO_MODE=true
MAX_PARTICIPANTS=200
